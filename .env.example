# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_platform

# Authentication Secrets
JWT_SECRET=super_secret_jwt_production_signing_key_2026
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=cloudyuu124@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-secret

# Cross-Origin Client & Server URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Optional SMTP notifications for contact form submissions.
# For Gmail, use an App Password (never your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Defaults to the contact email configured in website Settings, then ADMIN_EMAIL.
CONTACT_NOTIFICATION_EMAIL=
